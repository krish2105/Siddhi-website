# -------------------------------------------------------------
# AURELLE LUXE STORE - PRODUCTION ENVIRONMENT CONFIGURATION
# -------------------------------------------------------------
# Copy this file to .env.local for local testing or add these
# keys into Vercel -> Project Settings -> Environment Variables.

# 1. PAYMENT GATEWAY (Razorpay / Cashfree)
# Get your Key ID from: https://dashboard.razorpay.com/#/app/keys
VITE_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxxx
VITE_MERCHANT_NAME="Aurelle Luxury Hygiene"

# 2. WHATSAPP CONCIERGE & CLOUD WEBHOOK
# Official customer concierge WhatsApp number (with country code, no + or spaces)
VITE_WHATSAPP_NUMBER=919820012345

# Optional: Automated Cloud API Webhook URL (Wati, Interakt, Gupshup, Make, or Zapier)
# When set, every order triggers an automated server-side order confirmation payload.
VITE_WHATSAPP_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/xxxxxx/xxxxxx/

# 3. SHIPROCKET & CARRIER LOGISTICS (Optional API Token)
# Pre-configured with native 6-digit PIN code serviceability for Blue Dart Air & Delhivery.
VITE_SHIPROCKET_API_TOKEN=

# 4. MARKETING & ADVERTISING CONVERSION PIXELS
# Meta (Facebook & Instagram Ads) Pixel ID from Meta Events Manager:
VITE_META_PIXEL_ID=

# Google Analytics 4 Measurement ID from Google Analytics Admin (G-XXXXXXXXXX):
VITE_GA4_MEASUREMENT_ID=
